/**
 * Menjalankan sinkronisasi berkala dengan pemetaan header Manpower yang sama
 * seperti sinkronisasi manual. Kolom Section, Superior, dan Jabatan tidak digunakan.
 */
function runBackgroundSync() {
  return executeManualSyncInternal();
}

/**
 * Migrasi satu kali untuk membersihkan kolom legacy dari sheet Manpower.
 * Jalankan manual dari Apps Script setelah kode diunggah.
 */
function removeLegacyManpowerColumns() {
  const ss = SpreadsheetApp.openById(SPREADSHEET_ID);
  const manpowerSheet = ss.getSheetByName(DB_MP_SHEET_NAME);
  if (!manpowerSheet) {
    throw new Error('Sheet Manpower tidak ditemukan.');
  }

  const headers = manpowerSheet
    .getRange(1, 1, 1, manpowerSheet.getLastColumn())
    .getDisplayValues()[0]
    .map(header => String(header).trim().toLowerCase());

  const legacyIndexes = headers
    .map((header, index) => (
      header === 'section' || header === 'superior' || header === 'jabatan'
        ? index + 1
        : -1
    ))
    .filter(index => index !== -1)
    .sort((a, b) => b - a);

  legacyIndexes.forEach(column => manpowerSheet.deleteColumn(column));

  return {
    success: true,
    deletedColumns: legacyIndexes.length,
    message: legacyIndexes.length
      ? 'Kolom Section, Superior, dan/atau Jabatan telah dihapus.'
      : 'Kolom Section, Superior, dan Jabatan tidak ditemukan.'
  };
}

function createTimeDrivenTriggers() {
  var triggers = ScriptApp.getProjectTriggers();
  for (var i = 0; i < triggers.length; i++) {
    if (triggers[i].getHandlerFunction() === 'runBackgroundSync') {
      ScriptApp.deleteTrigger(triggers[i]);
    }
  }

  ScriptApp.newTrigger('runBackgroundSync')
    .timeBased()
    .everyHours(1)
    .create();
}
